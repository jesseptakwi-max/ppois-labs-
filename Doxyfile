# Doxyfile for PPOIS Labs - Lab 1
# Run from the repository root with: doxygen Doxyfile

PROJECT_NAME           = "PPOIS Labs - Lab 1"
PROJECT_BRIEF          = "C++ Lab 1: Polynomial and Tic-Tac-Toe"
OUTPUT_DIRECTORY       = docs/doxygen

# Source files to document
INPUT                  = lab1/Polynomial/src \
                         lab1/tictactoe/src
FILE_PATTERNS          = *.h *.hpp *.cpp
RECURSIVE              = YES

# Generate HTML documentation
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

# Include class members even before every item has a Doxygen comment.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

# Documentation parsing and warnings
OPTIMIZE_OUTPUT_FOR_C  = NO
MARKDOWN_SUPPORT       = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

# Keep output readable and avoid unrelated generated files.
QUIET                  = NO
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = NO

# Diagrams are optional; do not require Graphviz.
HAVE_DOT               = NO
